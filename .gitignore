# also match symlinked model dirs (trailing-slash patterns skip symlinks)
/Dream-v0-Base-7B
/Dream-v0-Instruct-7B
/LLaDA-8B-Instruct
.env
__pycache__/
*.pyc
bias_steering/*.pt
*.pt
*.safetensors
data/bbq_cache/
data/bbq_items/
*.csv
bias_steering/.crows_cache/
bias_steering/directions/
race_steering/.stereoset_cache/
gw_*.log

# UNQOVER: raw/generated data (large) + item dumps stay local
data/unqover/

# internal session notes — keep local only
handoff.md
new_idea_sanity_test/HANDOFF.md
.local_notes/

# root-level LaTeX-run residue (explicit entries — a bare *.log would also
# hide future logs we might want to track)
/bib.log
/compile.log

# Dream port: built artifacts stay local (large tensors, eval caches)
dream/arrows.pt
dream/cache/
dream/direction_examples.jsonl
dream/baselines/cache/
results/dream/
logs/

# multirace: built artifacts stay local (large tensors, contrast dumps)
multirace/arrows_*.pt
multirace/direction_examples_*.jsonl

# E1 trajectory analysis: the small summary tables are tracked (they back
# FINDINGS.md); the big per_item.csv stays local (regenerated by
# analysis/trajectory/traj_analysis.py from the committed samples).
!analysis/trajectory/summary_*.csv

# balanced_all: rotation item files stay local; summary markdown plus the
# per-rotation condition result JSONs and samples under black/ are tracked
# (the paper's reproducibility statement requires the committed samples).
results/balanced_all/**
!results/balanced_all/*.md
!results/balanced_all/black/
!results/balanced_all/black/**/
!results/balanced_all/black/**/cond_*.json
!results/balanced_all/black/**/cond_*_samples.jsonl
# round 2: multi-target balanced runs (arab/asian/latino/white) are tracked
# the same way (rotation item files stay local).
!results/balanced_all/arab/
!results/balanced_all/arab/**/
!results/balanced_all/arab/**/cond_*.json
!results/balanced_all/arab/**/cond_*_samples.jsonl
!results/balanced_all/asian/
!results/balanced_all/asian/**/
!results/balanced_all/asian/**/cond_*.json
!results/balanced_all/asian/**/cond_*_samples.jsonl
!results/balanced_all/latino/
!results/balanced_all/latino/**/
!results/balanced_all/latino/**/cond_*.json
!results/balanced_all/latino/**/cond_*_samples.jsonl
!results/balanced_all/white/
!results/balanced_all/white/**/
!results/balanced_all/white/**/cond_*.json
!results/balanced_all/white/**/cond_*_samples.jsonl
# round 3 (E3): gender balanced runs (woman/man) are tracked the same way
# (rotation item files stay local).
!results/balanced_all/woman/
!results/balanced_all/woman/**/
!results/balanced_all/woman/**/cond_*.json
!results/balanced_all/woman/**/cond_*_samples.jsonl
!results/balanced_all/man/
!results/balanced_all/man/**/
!results/balanced_all/man/**/cond_*.json
!results/balanced_all/man/**/cond_*_samples.jsonl
# round 3 (E6): fblack balanced runs (gender-conditioned race direction) are
# tracked the same way (rotation item files stay local).
!results/balanced_all/fblack/
!results/balanced_all/fblack/**/
!results/balanced_all/fblack/**/cond_*.json
!results/balanced_all/fblack/**/cond_*_samples.jsonl
